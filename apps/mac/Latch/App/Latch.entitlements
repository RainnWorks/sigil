<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  The app is not sandboxed: it shells out to the `latch` CLI and talks to the
	  daemon's unix socket, both outside a sandbox container. This matches the
	  posture of a personal admin tool that drives a local daemon; it is not a
	  Mac App Store product.
	-->
	<key>com.apple.security.app-sandbox</key>
	<false/>
	<!--
	  Secure Enclave keys the app mints for local Touch ID approvals live in the
	  app's own keychain access group. Kept explicit so the SE seam and any future
	  helper share one group.
	-->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)co.rowm.latch</string>
	</array>
</dict>
</plist>
