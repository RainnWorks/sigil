<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIconFile</key>
	<string>Sigil</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>Sigil</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSMinimumSystemVersion</key>
	<string>$(MACOSX_DEPLOYMENT_TARGET)</string>
	<!-- Agent app: menubar-first, no Dock icon, no app-switcher entry. -->
	<key>LSUIElement</key>
	<true/>
	<key>NSHumanReadableCopyright</key>
	<string>Personal instrument. Single user.</string>
	<!--
	  Sparkle. The feed is the appcast the release workflow attaches to every
	  GitHub Release; /latest/download/ always resolves to the newest one.
	  SUPublicEDKey is the public half of the one RainnWorks Sparkle key (the
	  private half is the RW_SPARKLE_PRIVATE_KEY organization secret). The
	  release workflow re-derives the public key from that secret and refuses to
	  publish if it does not match this string, so a key swap cannot ship an
	  update this app would reject.
	-->
	<key>SUEnableAutomaticChecks</key>
	<true/>
	<key>SUFeedURL</key>
	<string>https://github.com/RainnWorks/sigil/releases/latest/download/appcast.xml</string>
	<key>SUPublicEDKey</key>
	<string>u3ZheIeb81NurueqlFoFV2mfOMqXaHVVTC0iLdDt75Y=</string>
</dict>
</plist>
