\
require "tempfile"
require "shellwords"
require "fileutils"
require "tmpdir"

default_platform(:ios)

# App Store Connect API key, used both for auto-provisioning at archive time and
# for the TestFlight upload. Resolution order mirrors the TileCam/GlassView
# setup so local runs need zero config:
#   1. CI env: ASC_KEY_ID, ASC_ISSUER_ID, and either ASC_KEY_CONTENT (base64 .p8,
#      with ASC_KEY_CONTENT_BASE64=true) or ASC_API_KEY_P8 (raw PEM).
#   2. The .p8 already at ~/.appstoreconnect/private_keys/ (no 1Password prompt).
#   3. Pulled once from 1Password (my.1password.com -> Private ->
#      "ASC API Key - Sigil Build Upload (RainnWorks)"); op must be signed in.
# Key ID and Issuer ID are identifiers, not secrets.
def asc_api_key
  key_id = ENV["ASC_KEY_ID"] || "454G953UNX"
  issuer = ENV["ASC_ISSUER_ID"] || "c73bbb08-c295-4f05-8941-061c35640941"
  key_content = ENV["ASC_KEY_CONTENT"] || ENV["ASC_API_KEY_P8"]
  if key_content
    return app_store_connect_api_key(
      key_id: key_id,
      issuer_id: issuer,
      key_content: key_content,
      is_key_content_base64: ENV["ASC_KEY_CONTENT_BASE64"] == "true",
      in_house: false
    )
  end

  standard = File.expand_path("~/.appstoreconnect/private_keys/AuthKey_#{key_id}.p8")
  key_path = File.exist?(standard) ? standard : File.join(Dir.tmpdir, "asc_sigil_#{key_id}.p8")
  unless File.exist?(key_path)
    UI.message("Fetching App Store Connect API key from 1Password...")
    sh("env -u OP_SERVICE_ACCOUNT_TOKEN op --account my.1password.com document get " \
       "'ASC API Key - Sigil Build Upload (RainnWorks)' --vault Private " \
       "--out-file #{key_path.shellescape}")
  end
  app_store_connect_api_key(key_id: key_id, issuer_id: issuer, key_filepath: key_path, in_house: false)
end

# fastlane's own Dir.pwd is fastlane/ itself (confirmed empirically - it does
# NOT cd up to the repo root the way some fastlane docs imply), so every path
# below is built from this instead of assumed relative to cwd.
ROOT = File.expand_path("..", __dir__)

# ---------------------------------------------------------------------------
# iOS: Sigil (apps/phone)
# ---------------------------------------------------------------------------
platform :ios do
  desc "Build and sign the Sigil app via match, upload to TestFlight"
  desc ""
  desc "Signing uses fastlane match: the App Store distribution cert + profile"
  desc "stored AES-encrypted in the ios-certificates repo (mirrors TileCam), so"
  desc "codesign runs in a dedicated prompt-free keychain and never blocks."
  desc "Requires (see docs/RELEASE.md):"
  desc "  MATCH_GIT_URL, MATCH_PASSWORD  - from ~/tilecam-build/ci.env or GHA secrets"
  desc "  ASC_* or the .p8 under ~/.appstoreconnect (see asc_api_key above)"
  desc "  IOS_TEAM_ID                    - Apple team id (defaults to 53W966FBFP)"
  desc ""
  desc "Set SIGIL_ARCHIVE_PATH=<path.xcarchive> to re-export an existing archive"
  desc "and skip the full rebuild."
  lane :beta do
    api_key = asc_api_key
    team_id = ENV["IOS_TEAM_ID"] || "53W966FBFP"
    app_id  = "works.rainn.sigil"
    profile = "match AppStore #{app_id}"

    # apps/phone/ios/ is generated (gitignored) - Expo continuous native
    # generation. Locally, run `bunx expo prebuild -p ios` in apps/phone/ first
    # if ios/ is missing or stale.
    ios_dir = File.join(ROOT, "apps/phone/ios")
    UI.user_error!("apps/phone/ios is missing - run `bunx expo prebuild -p ios` in apps/phone/ first") unless Dir.exist?(ios_dir)

    # A dedicated, unlocked, prompt-free keychain (the same one CI would use).
    # Without it, codesign is denied the login keychain from a non-interactive
    # shell (errSecInternalComponent). Runs locally too, not just in CI.
    setup_ci(force: true)

    # Fetch, or on first run for this app id create, the App Store distribution
    # cert + provisioning profile from the ios-certificates repo and install
    # them into that keychain.
    match(
      type: "appstore",
      app_identifier: app_id,
      api_key: api_key,
      readonly: false
    )

    export_opts = {
      workspace: File.join(ios_dir, "Sigil.xcworkspace"),
      scheme: "Sigil",
      export_method: "app-store",
      output_directory: File.join(ROOT, "build/ios"),
      output_name: "Sigil.ipa",
      export_options: {
        signingStyle: "manual",
        teamID: team_id,
        provisioningProfiles: { app_id => profile }
      }
    }

    reuse = ENV["SIGIL_ARCHIVE_PATH"]
    if reuse && Dir.exist?(reuse)
      # Re-export an already-built archive with the match profile (skips ~40 min).
      UI.message("Reusing archive: #{reuse}")
      gym(**export_opts, skip_build_archive: true, archive_path: reuse)
    else
      # TestFlight needs a strictly increasing CFBundleVersion per version string.
      build_number = ENV["GITHUB_RUN_NUMBER"] || Time.now.strftime("%Y%m%d%H%M")
      increment_build_number(xcodeproj: File.join(ios_dir, "Sigil.xcodeproj"), build_number: build_number)
      update_code_signing_settings(
        path: File.join(ios_dir, "Sigil.xcodeproj"),
        use_automatic_signing: false,
        team_id: team_id,
        code_sign_identity: "Apple Distribution",
        targets: ["Sigil"],
        profile_name: profile
      )
      gym(**export_opts, configuration: "Release", clean: true)
    end

    upload_to_testflight(
      api_key: api_key,
      ipa: File.join(ROOT, "build/ios/Sigil.ipa"),
      skip_waiting_for_build_processing: true,
      skip_submission: true
    )
  end
end

# ---------------------------------------------------------------------------
# macOS: Latch configurator (apps/mac)
# ---------------------------------------------------------------------------
platform :mac do
  desc "Generate, build, sign, and notarize the Latch macOS app; package a DMG"
  desc ""
  desc "Requires (see docs/RELEASE.md):"
  desc "  MAC_ASC_KEY_ID, MAC_ASC_ISSUER_ID, MAC_ASC_API_KEY_P8  - ASC API key for notarization"
  desc "  MAC_TEAM_ID                                            - Apple team id signing the app"
  desc ""
  desc "MAC_* credentials are named separately from the iOS ASC_* ones because, until #35"
  desc "(migrate the Mac identity Rowm LTD -> Rainnworks) lands, the two apps sign under"
  desc "different Apple Developer teams. Once that migration ships, both can point at the"
  desc "same key and this comment (and the duplicate secrets) should go away."
  lane :release do
    ensure_env_vars(
      env_vars: ["MAC_ASC_KEY_ID", "MAC_ASC_ISSUER_ID", "MAC_ASC_API_KEY_P8", "MAC_TEAM_ID"]
    )

    mac_dir = File.join(ROOT, "apps/mac")
    build_dir = File.join(ROOT, "build/mac")
    FileUtils.mkdir_p(build_dir)

    # Latch.xcodeproj is generated (see apps/mac/project.yml's own header) -
    # never hand-edited, never assumed fresh in CI.
    Dir.chdir(mac_dir) { sh("xcodegen generate") }

    gym(
      project: File.join(mac_dir, "Latch.xcodeproj"),
      scheme: "Latch",
      configuration: "Release",
      export_method: "developer-id",
      output_directory: build_dir,
      output_name: "Latch.app",
      skip_package_ipa: true,
      clean: true,
      xcargs: "-allowProvisioningUpdates DEVELOPMENT_TEAM=#{ENV['MAC_TEAM_ID']}"
    )

    app_path = File.join(build_dir, "Latch.app")
    zip_path = File.join(build_dir, "Latch.zip")
    dmg_path = File.join(build_dir, "Latch.dmg")

    # notarytool wants a zip/dmg/pkg, not a raw .app bundle, for submission.
    sh("ditto -c -k --keepParent #{app_path.shellescape} #{zip_path.shellescape}")

    # The API key needs to be a file on disk for notarytool; write it to a
    # tempfile that never leaves this process (no path under version control,
    # nothing logged).
    key_file = Tempfile.new(["asc_notarize_key", ".p8"])
    begin
      key_file.write(ENV["MAC_ASC_API_KEY_P8"])
      key_file.close

      sh(
        "xcrun notarytool submit #{zip_path.shellescape} " \
        "--key #{key_file.path.shellescape} " \
        "--key-id #{ENV['MAC_ASC_KEY_ID'].shellescape} " \
        "--issuer #{ENV['MAC_ASC_ISSUER_ID'].shellescape} " \
        "--wait"
      )
    ensure
      key_file.unlink
    end

    # Staple the .app itself (what Gatekeeper actually checks at launch), not
    # the zip used only to ship it to Apple's notary service.
    sh("xcrun stapler staple #{app_path.shellescape}")

    # Package the stapled, notarized .app into the DMG that ships.
    sh(
      "hdiutil create -volname Latch -srcfolder #{app_path.shellescape} " \
      "-ov -format UDZO #{dmg_path.shellescape}"
    )

    UI.success("Notarized DMG ready at #{dmg_path}")
  end
end
