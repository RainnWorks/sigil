\
require "tempfile"
require "shellwords"
require "fileutils"
require "base64"

default_platform(:ios)

RW_ASC_ENV = %w[RW_ASC_KEY_ID RW_ASC_ISSUER_ID RW_ASC_KEY_P8].freeze

def require_rw_asc_env!
  missing = RW_ASC_ENV.reject { |name| ENV[name].to_s.strip != "" }
  return if missing.empty?
  UI.user_error!("Missing #{missing.join(', ')}. On a Mac run lanes as " \
                 "`rw-apple exec -- bundle exec fastlane <platform> <lane>`. " \
                 "In CI set the RW_* secrets. See RainnWorks/apple-signing.")
end

def asc_api_key
  require_rw_asc_env!
  app_store_connect_api_key(
    key_id: ENV.fetch("RW_ASC_KEY_ID"),
    issuer_id: ENV.fetch("RW_ASC_ISSUER_ID"),
    key_content: ENV.fetch("RW_ASC_KEY_P8"),
    is_key_content_base64: true,
    in_house: false
  )
end

# fastlane's own Dir.pwd is fastlane/ itself (confirmed empirically - it does
# NOT cd up to the repo root the way some fastlane docs imply), so every path
# below is built from this instead of assumed relative to cwd.
ROOT = File.expand_path("..", __dir__)

# ---------------------------------------------------------------------------
# iOS: Sigil (apps/phone)
# ---------------------------------------------------------------------------
platform :ios do
  desc "Build and sign the Sigil app, upload to TestFlight"
  desc ""
  desc "Signing comes from RainnWorks/apple-signing. On a Mac the lane runs"
  desc "`rw-apple sync sigil` itself; in CI the workflow runs the sync step first."
  desc "Run it as `rw-apple exec -- bundle exec fastlane ios beta` so the RW_* secrets are set."
  desc "  IOS_TEAM_ID  - Apple team id (defaults to 53W966FBFP)"
  desc ""
  desc "Set SIGIL_ARCHIVE_PATH=<path.xcarchive> to re-export an existing archive"
  desc "and skip the full rebuild."
  lane :beta do
    api_key = asc_api_key
    team_id = ENV["IOS_TEAM_ID"] || "53W966FBFP"
    app_id  = "works.rainn.sigil"
    profile = "RW AppStore #{app_id}"

    # apps/phone/ios/ is generated (gitignored) - Expo continuous native
    # generation. Locally, run `bunx expo prebuild -p ios` in apps/phone/ first
    # if ios/ is missing or stale.
    ios_dir = File.join(ROOT, "apps/phone/ios")
    UI.user_error!("apps/phone/ios is missing - run `bunx expo prebuild -p ios` in apps/phone/ first") unless Dir.exist?(ios_dir)

    sh("rw-apple", "sync", "sigil") unless is_ci

    export_opts = {
      workspace: File.join(ios_dir, "Sigil.xcworkspace"),
      scheme: "Sigil",
      export_method: "app-store",
      output_directory: File.join(ROOT, "build/ios"),
      output_name: "Sigil.ipa",
      export_options: {
        signingStyle: "manual",
        teamID: team_id,
        provisioningProfiles: { app_id => profile }
      }
    }

    reuse = ENV["SIGIL_ARCHIVE_PATH"]
    if reuse && Dir.exist?(reuse)
      # Re-export an already-built archive with the RW AppStore profile (skips ~40 min).
      UI.message("Reusing archive: #{reuse}")
      gym(**export_opts, skip_build_archive: true, archive_path: reuse)
    else
      # TestFlight needs a strictly increasing CFBundleVersion per version string.
      build_number = ENV["GITHUB_RUN_NUMBER"] || Time.now.strftime("%Y%m%d%H%M")
      increment_build_number(xcodeproj: File.join(ios_dir, "Sigil.xcodeproj"), build_number: build_number)
      update_code_signing_settings(
        path: File.join(ios_dir, "Sigil.xcodeproj"),
        use_automatic_signing: false,
        team_id: team_id,
        code_sign_identity: "Apple Distribution",
        targets: ["Sigil"],
        profile_name: profile
      )
      gym(**export_opts, configuration: "Release", clean: true)
    end

    upload_to_testflight(
      api_key: api_key,
      ipa: File.join(ROOT, "build/ios/Sigil.ipa"),
      skip_waiting_for_build_processing: true,
      skip_submission: true
    )
  end
end

# ---------------------------------------------------------------------------
# macOS: Sigil configurator (apps/mac)
# ---------------------------------------------------------------------------
platform :mac do
  desc "Generate, build, sign, and notarize the Sigil macOS app; package a DMG"
  desc ""
  desc "Signing comes from RainnWorks/apple-signing. On a Mac the lane runs"
  desc "`rw-apple sync sigil-mac` itself; in CI the workflow runs the sync step first."
  desc "Run it as `rw-apple exec -- bundle exec fastlane mac release` so the RW_* secrets are set."
  desc "The same RW_ASC_* key notarizes the app."
  desc ""
  desc "Apple identity (mirrors apps/phone/app.config.js), both default to Rainnworks:"
  desc "  SIGIL_MAC_TEAM_ID     - Apple team id signing the app (default 53W966FBFP)"
  desc "  SIGIL_MAC_BUNDLE_ID   - app bundle id (default works.rainn.sigil.mac)"
  desc "A self-hoster also needs a Developer ID profile named \"RW DeveloperID <bundle id>\"."
  lane :release do
    require_rw_asc_env!

    team_id   = ENV["SIGIL_MAC_TEAM_ID"] || "53W966FBFP"
    bundle_id = ENV["SIGIL_MAC_BUNDLE_ID"] || "works.rainn.sigil.mac"
    profile   = "RW DeveloperID #{bundle_id}"

    mac_dir = File.join(ROOT, "apps/mac")
    build_dir = File.join(ROOT, "build/mac")
    FileUtils.mkdir_p(build_dir)

    sh("rw-apple", "sync", "sigil-mac") unless is_ci

    # Sigil.xcodeproj is generated (see apps/mac/project.yml's own header) -
    # never hand-edited, never assumed fresh in CI.
    Dir.chdir(mac_dir) { sh("xcodegen generate") }

    # project.yml indirects PRODUCT_BUNDLE_IDENTIFIER / DEVELOPMENT_TEAM through the
    # SIGIL_MAC_* build settings (default Rainnworks); pass the resolved values so a
    # self-hoster's env override reaches codesign, keychain group, and the profile.
    gym(
      project: File.join(mac_dir, "Sigil.xcodeproj"),
      scheme: "Sigil",
      configuration: "Release",
      export_method: "developer-id",
      export_options: {
        signingStyle: "manual",
        teamID: team_id,
        provisioningProfiles: { bundle_id => profile }
      },
      output_directory: build_dir,
      output_name: "Sigil.app",
      skip_package_ipa: true,
      clean: true,
      xcargs: "SIGIL_MAC_TEAM_ID=#{team_id.shellescape} " \
              "SIGIL_MAC_BUNDLE_ID=#{bundle_id.shellescape} " \
              "DEVELOPMENT_TEAM=#{team_id.shellescape} " \
              "CODE_SIGN_STYLE=Manual " \
              "CODE_SIGN_IDENTITY=#{'Developer ID Application'.shellescape} " \
              "PROVISIONING_PROFILE_SPECIFIER=#{profile.shellescape}"
    )

    app_path = File.join(build_dir, "Sigil.app")
    zip_path = File.join(build_dir, "Sigil.zip")
    dmg_path = File.join(build_dir, "Sigil.dmg")

    # notarytool wants a zip/dmg/pkg, not a raw .app bundle, for submission.
    sh("ditto -c -k --keepParent #{app_path.shellescape} #{zip_path.shellescape}")

    # The API key needs to be a file on disk for notarytool; write it to a
    # tempfile that never leaves this process (no path under version control,
    # nothing logged).
    key_file = Tempfile.new(["asc_notarize_key", ".p8"])
    begin
      key_file.write(Base64.decode64(ENV.fetch("RW_ASC_KEY_P8")))
      key_file.close

      sh(
        "xcrun notarytool submit #{zip_path.shellescape} " \
        "--key #{key_file.path.shellescape} " \
        "--key-id #{ENV.fetch('RW_ASC_KEY_ID').shellescape} " \
        "--issuer #{ENV.fetch('RW_ASC_ISSUER_ID').shellescape} " \
        "--wait"
      )
    ensure
      key_file.unlink
    end

    # Staple the .app itself (what Gatekeeper actually checks at launch), not
    # the zip used only to ship it to Apple's notary service.
    sh("xcrun stapler staple #{app_path.shellescape}")

    # Package the stapled, notarized .app into the DMG that ships.
    sh(
      "hdiutil create -volname Sigil -srcfolder #{app_path.shellescape} " \
      "-ov -format UDZO #{dmg_path.shellescape}"
    )

    UI.success("Notarized DMG ready at #{dmg_path}")
  end
end
