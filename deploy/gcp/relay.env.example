# relay.env.example - environment for the sigil-relay systemd service.
#
# Copy to /etc/sigil/relay.env (setup.sh does this if it is absent), owned by
# the sigil user, mode 0640. This file holds NO secret itself: the APNs key is a
# separate 0600 file referenced by path below. Never commit a real relay.env.
#
# These are the ONLY variables the relay binary reads (verified against
# crates/sigil-relay: main.rs + lib.rs + push.rs). Anything else here is ignored.

# --- listen address + port ---
# The relay binds BIND_ADDR:PORT. TLS is terminated by Caddy in front; the relay
# speaks plain HTTP. Caddy reverse-proxies to 127.0.0.1:8080, so keep PORT 8080.
# (Default in the binary is 8787 if unset; we pin 8080 to match the Caddyfile.)
PORT=8080
#
# BIND_ADDR pins the listener interface. Default in the binary is 0.0.0.0 (all
# interfaces) so behavior is unchanged when unset. Here Caddy is the only thing
# that should reach the relay, so we bind loopback for defense-in-depth: even if
# the GCP firewall were misconfigured, :8080 is not reachable off the box. An
# unparsable value falls back to 0.0.0.0 with a warning.
BIND_ADDR=127.0.0.1

# --- doorbell / knock mode ---
# direct   = this relay holds the APNs key and sends the wake itself (what a
#            first-party publisher-hosted relay runs).
# upstream = hold no Apple key; forward an opaque knock to KNOCK_UPSTREAM.
# off      = no doorbell; clients fall back to their foreground poll.
# If unset it is inferred: direct when an APNs key is present, else upstream when
# KNOCK_UPSTREAM is set, else off. We set it explicitly to fail loud on a
# misconfigured key.
KNOCK_MODE=direct

# --- APNs signing key (direct mode) ---
# Path to the APNs auth key (.p8 PEM). The operator places this file at
# /etc/sigil/apns.p8 with mode 0600, owned by sigil. The relay reads it once at
# doorbell time and never logs it.
APNS_KEY_P8_PATH=/etc/sigil/apns.p8

# Alternative to APNS_KEY_P8_PATH: the raw PEM text inline. Discouraged on a
# shared host (it shows in `systemctl show` / process env). Leave this unset when
# using the file above.
# APNS_KEY_P8=

# --- APNs identity (direct mode) ---
# The topic (app bundle id), Apple team id (JWT iss), and auth-key id (JWT kid).
# Each is env-configurable and defaults to the official Rainnworks identity when
# unset, so the published build is byte-identical with these left blank. A
# self-hoster running their own Apple app + APNs key sets all three to match
# their .p8; the values must be consistent with the key you install above.
# APNS_TOPIC=works.rainn.sigil
# APNS_TEAM_ID=53W966FBFP
# APNS_KEY_ID=5PCK76SDBA

# --- upstream mode only (leave unset for a first-party direct relay) ---
# Base URL of the upstream direct relay to forward opaque knocks to.
# KNOCK_UPSTREAM=https://relay.example.com

# --- long-poll window (milliseconds) ---
# Leave unset in production; the binary default is 25000. Only tests shrink it.
# LONG_POLL_MS=25000
