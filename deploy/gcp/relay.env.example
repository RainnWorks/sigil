# relay.env.example - environment for the sigil-relay systemd service.
#
# Copy to /etc/sigil/relay.env (setup.sh does this if it is absent), owned by
# the sigil user, mode 0640. This file holds NO secret itself: the APNs key is a
# separate 0600 file referenced by path below. Never commit a real relay.env.
#
# These are the ONLY variables the relay binary reads (verified against
# crates/sigil-relay: main.rs + lib.rs). Anything else here is ignored.

# --- listen port ---
# The relay binds this port. TLS is terminated by Caddy in front; the relay
# speaks plain HTTP. Caddy reverse-proxies to 127.0.0.1:8080, so keep this 8080.
# (Default in the binary is 8787 if unset; we pin 8080 to match the Caddyfile.)
PORT=8080

# --- doorbell / knock mode ---
# direct   = this relay holds the APNs key and sends the wake itself (what the
#            Rainnworks-hosted relay runs).
# upstream = hold no Apple key; forward an opaque knock to KNOCK_UPSTREAM.
# off      = no doorbell; clients fall back to their foreground poll.
# If unset it is inferred: direct when an APNs key is present, else upstream when
# KNOCK_UPSTREAM is set, else off. We set it explicitly to fail loud on a
# misconfigured key.
KNOCK_MODE=direct

# --- APNs signing key (direct mode) ---
# Path to the Rainnworks APNs auth key (.p8 PEM). The operator places this file
# at /etc/sigil/apns.p8 with mode 0600, owned by sigil. The relay reads it once
# at doorbell time and never logs it.
#
# The APNs identity (topic works.rainn.sigil, team 53W966FBFP, key id 5PCK76SDBA)
# is COMPILED INTO the binary (crates/sigil-relay/src/push.rs), NOT read from the
# environment. Do not add APNS_TOPIC / APNS_TEAM_ID / APNS_KEY_ID here; they have
# no effect. The .p8 you supply must match key id 5PCK76SDBA for that team.
APNS_KEY_P8_PATH=/etc/sigil/apns.p8

# Alternative to APNS_KEY_P8_PATH: the raw PEM text inline. Discouraged on a
# shared host (it shows in `systemctl show` / process env). Leave this unset when
# using the file above.
# APNS_KEY_P8=

# --- upstream mode only (leave unset for the Rainnworks direct relay) ---
# Base URL of the upstream direct relay to forward opaque knocks to.
# KNOCK_UPSTREAM=https://relay.rainn.works

# --- long-poll window (milliseconds) ---
# Leave unset in production; the binary default is 25000. Only tests shrink it.
# LONG_POLL_MS=25000
