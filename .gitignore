# fastlane/Fastfile's ios/mac lanes stage the .ipa, the notarized .app/.dmg,
# and the fastlane report/log here.
/build/
fastlane/report.xml
fastlane/*.log
# Auto-regenerated from each lane's `desc` every run; docs/RELEASE.md is the
# maintained doc, this would just drift out of sync with it.
fastlane/README.md

# Read-only vendored prior art with its own git history; kept on disk, out of
# this repo's tree so it is never modified or committed as a broken gitlink.
reference/

# internal-only material (release runbooks, marketing plans, ops notes); never published
internal-docs/
