{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sigil-relay",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-04",
  // Keep the workers.dev URL live alongside the custom domain, so the relay is
  // reachable during DNS propagation and as a fallback. The default clients
  // point at relay.rainn.works.
  "workers_dev": true,
  // One Durable Object per mailbox, keyed by the 64-hex mailbox id. It holds
  // that mailbox's envelopes only in its own instance memory; it makes zero
  // storage writes (no persisted queue, no persisted counter). See
  // src/index.ts. The sqlite backing below is declared but unused: nothing in
  // this class ever calls ctx.storage.
  "durable_objects": {
    "bindings": [{ "name": "MAILBOX", "class_name": "Mailbox" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Mailbox"] }],
  // Bundles ../landing.html into src/index.ts as a raw text module (see
  // src/html.d.ts for the matching ambient type), so GET / serves the exact
  // same bytes as the Bun variant's readFileSync of that one source file.
  "rules": [{ "type": "Text", "globs": ["**/*.html"] }],
  // Deliberately OFF. Request logs would record mailbox ids and timing, which is
  // exactly the metadata this relay promises never to retain. See README.
  "observability": { "enabled": false },
  // The publisher's shared instance is served from this custom domain. The zone
  // (rainn.works) must be in the same Cloudflare account; the record + edge cert
  // are provisioned by `wrangler deploy`. See DEPLOY.md.
  "routes": [{ "pattern": "relay.rainn.works", "custom_domain": true }]
  // APNS_KEY_P8 (the publisher's APNs .p8 signing key, PEM text) is a secret,
  // not a var: set it with `wrangler secret put APNS_KEY_P8`, never committed
  // here. Absent, the push doorbell is disabled and every deposit still
  // succeeds, relying on the phone's poll backstop. See shared/push.ts.
  //
  // Without a route, `wrangler deploy` publishes to the default
  // latch-relay.<subdomain>.workers.dev. To serve this from your own domain
  // instead (the domain must already be a zone in the same Cloudflare
  // account), add a routes block, e.g.:
  // "routes": [{ "pattern": "relay.rainn.works", "custom_domain": true }]
  // See DEPLOY.md for the full runbook.
}
