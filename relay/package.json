{
  "name": "latch-relay",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Latch blind relay: a tiny store-and-forward mailbox for opaque sealed envelopes.",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "start:bun": "bun run bun/server.ts",
    "test": "vitest run",
    "test:bun": "bun test bun/server.test.ts",
    "typecheck": "tsc --noEmit",
    "typecheck:bun": "tsc -p bun/tsconfig.json"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.9.0",
    "@cloudflare/workers-types": "^4.20250704.0",
    "bun-types": "^1.1.0",
    "typescript": "^5.6.0",
    "vitest": "~3.2.0",
    "wrangler": "^4.0.0"
  }
}
